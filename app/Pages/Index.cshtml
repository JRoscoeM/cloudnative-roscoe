@page
@model IndexModel
@{
    ViewData["Title"] = "Headroom";
}

<header class="intro">
    <h1>ConferenceVision</h1>
    <a class="button" href="/snapshot">Report a room with a photo</a>
</header>

@* Polling pauses while the tab is hidden, so idle phones don't load the pods. *@
<div id="live" hx-get="/?handler=Live" hx-trigger="every 5s [document.visibilityState === 'visible']" hx-swap="innerHTML">
    <partial name="_Live" model="Model.Board" />
</div>

<section id="schedule" aria-labelledby="schedule-title">
    <h2 id="schedule-title">Schedule</h2>
    <label for="q">Find a talk by topic</label>
    <input id="q" name="q" type="search" autocomplete="off" placeholder="Try &quot;making clusters cheaper&quot;"
           hx-get="/?handler=Results" hx-trigger="input changed delay:350ms, search" hx-target="#results">
    <ul id="results" class="schedule">
        <partial name="_Results" model="Model.Results" />
    </ul>
</section>

<footer class="page-foot">
    <span>version @Model.Info.Version</span>
    <span>team @Model.Info.Team</span>
    <a href="/sensor">Set up a sensor</a>
    <a href="/organizer">Organizers</a>
</footer>
