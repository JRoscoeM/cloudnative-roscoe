@model Board

<svg class="map" viewBox="0 0 360 @Model.MapHeight" role="group" aria-label="Floor plan of the venue">
    @foreach (var room in Model.Rooms)
    {
        <a href="#room-@room.Id" class="map-room level-@room.Level.ToString().ToLowerInvariant()"
           aria-label="@room.Name, @(room.HasReading ? $"{room.Percent} percent full" : "no reading"), @room.Outlook">
            <rect x="@room.Area.X" y="@room.Area.Y" width="@room.Area.Width" height="@room.Area.Height" rx="10" />
            <text x="@(room.Area.X + 12)" y="@(room.Area.Y + 24)" class="map-name">@room.MapName</text>
            <text x="@(room.Area.X + 12)" y="@(room.Area.Y + 58)" class="map-percent">@room.PercentText</text>
            <text x="@(room.Area.X + 12)" y="@(room.Area.Y + 82)" class="map-note">@room.Outlook</text>
        </a>
    }

    @foreach (var queue in Model.Queues)
    {
        <a href="#line-@queue.Id" class="map-queue" aria-label="@queue.Name, @queue.WaitText">
            <rect x="@queue.Marker.X" y="@queue.Marker.Y" width="@queue.Marker.Width" height="@queue.Marker.Height" rx="20" />
            <text x="@(queue.Marker.X + queue.Marker.Width / 2)" y="@(queue.Marker.Y + 25)" text-anchor="middle">@queue.ShortName · @(queue.WaitMinutes is null ? "–" : queue.WaitText)</text>
        </a>
    }
</svg>
