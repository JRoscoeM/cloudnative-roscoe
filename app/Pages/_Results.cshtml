@model IReadOnlyList<TalkResult>
@foreach (var result in Model)
{
    <li class="level-@result.StatusLevel">
        <span class="schedule-time">@result.Session.Date.ToString("ddd") @result.Session.Time</span>
        <span class="schedule-body">
            <span class="schedule-title">@result.Session.Title</span>
        </span>
        <span class="schedule-meta">
            <span class="schedule-room">@result.RoomName</span>
            @if (result.Status is not null)
            {
                <span class="pill">@result.Status</span>
            }
        </span>
    </li>
}
@if (Model.Count == 0)
{
    <li class="schedule-empty">No matching sessions.</li>
}
